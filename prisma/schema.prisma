generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  SALES
  PROCUREMENT
  VIEWER
}

enum EnquiryStatus {
  DRAFT
  ENQUIRY_RECEIVED
  RFQ_SENT
  SUPPLIER_QUOTES_RECEIVED
  CUSTOMER_QUOTE_SENT
  AWAITING_APPROVAL
  APPROVED
  REJECTED
  PO_RECEIVED
  PURCHASE_SENT
  COMPLETED
  CANCELLED
}

enum PriceHistoryType {
  CUSTOMER_QUOTE
  SUPPLIER_COST
  SALE
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(SALES)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ownedEnquiries Enquiry[] @relation("EnquiryOwner")
  auditLogs      AuditLog[]
}

enum KycStatus {
  PENDING
  CLEAR
  REVIEW
  BLOCKED
}

enum MarketplaceKind {
  SUPPLIER
  SERVICE_PROVIDER
}

enum MatchStatus {
  UNMATCHED
  PARTIAL
  MATCHED
  EXCEPTION
}

enum PaymentStatus {
  DRAFT
  PENDING
  AUTHORIZED
  SETTLED
  FAILED
  CANCELLED
}

enum ContractStatus {
  DRAFT
  OPEN
  AWARDED
  ACTIVE
  EXPIRED
  CANCELLED
}

model CompanySettings {
  id              String   @id @default(cuid())
  companyName     String   @default("Northwharf")
  shortName       String   @default("NW")
  address         String?
  phone           String?
  email           String?
  website         String?
  defaultCurrency String   @default("USD")
  defaultMarginPct Decimal  @default(15) @db.Decimal(5, 2)
  enqPrefix       String   @default("NW-ENQ")
  rfqPrefix       String   @default("NW-RFQ")
  quotePrefix     String   @default("NW-QT")
  poPrefix        String   @default("NW-CPO")
  purchasePrefix  String   @default("NW-PO")
  invoicePrefix   String   @default("NW-INV")
  receiptPrefix   String   @default("NW-GRN")
  paymentPrefix   String   @default("NW-PAY")
  contractPrefix  String   @default("NW-CTR")
  enqSeq          Int      @default(0)
  rfqSeq          Int      @default(0)
  quoteSeq        Int      @default(0)
  poSeq           Int      @default(0)
  purchaseSeq     Int      @default(0)
  invoiceSeq      Int      @default(0)
  receiptSeq      Int      @default(0)
  paymentSeq      Int      @default(0)
  contractSeq     Int      @default(0)
  updatedAt       DateTime @updatedAt
}

model Port {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  country   String?
  region    String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  contracts Contract[]
}

model Customer {
  id        String   @id @default(cuid())
  code      String?  @unique
  name      String
  contact   String?
  email     String?
  phone     String?
  address   String?
  country   String?
  notes     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enquiries      Enquiry[]
  customerQuotes CustomerQuote[]
  purchaseOrders PurchaseOrder[]
  vessels        Vessel[]
}

model Supplier {
  id            String          @id @default(cuid())
  code          String?         @unique
  name          String
  contact       String?
  email         String?
  phone         String?
  address       String?
  country       String?
  leadTimeDays  Int?
  brandsServed  String?
  categories    String?
  portsServed   String?
  kind          MarketplaceKind @default(SUPPLIER)
  kycStatus     KycStatus       @default(PENDING)
  kycNotes      String?
  kycCheckedAt  DateTime?
  complianceHold Boolean        @default(false)
  paymentTermsDays Int?
  bankName      String?
  bankAccountRef String?
  ratingScore   Decimal?        @db.Decimal(4, 1)
  notes         String?
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  rfqs              SupplierRfq[]
  supplierQuotes    SupplierQuote[]
  supplierPurchases SupplierPurchase[]
  invoices          SupplierInvoice[]
  payments          Payment[]
  contracts         Contract[]
}

model Part {
  id           String   @id @default(cuid())
  partNumber   String   @unique
  description  String
  manufacturer String?
  brand        String?
  impaCode     String?
  category     String?
  unit         String   @default("EA")
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  enquiryLines       EnquiryLine[]
  supplierQuoteLines SupplierQuoteLine[]
  customerQuoteLines CustomerQuoteLine[]
  purchaseLines      SupplierPurchaseLine[]
  priceHistory       PriceHistory[]

  @@index([impaCode])
  @@index([brand])
}

model Vessel {
  id           String   @id @default(cuid())
  name         String
  imo          String?  @unique
  flag         String?
  vesselType   String?
  engineMake   String?
  engineModel  String?
  customerId   String?
  notes        String?
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customer  Customer? @relation(fields: [customerId], references: [id])
  enquiries Enquiry[]
}

model EnquiryTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  category    String?
  active      Boolean  @default(true)
  createdById String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  lines EnquiryTemplateLine[]
}

model EnquiryTemplateLine {
  id          String  @id @default(cuid())
  templateId  String
  partId      String?
  partNumber  String
  description String
  impaCode    String?
  brand       String?
  quantity    Decimal @default(1) @db.Decimal(12, 3)
  unit        String  @default("EA")
  sortOrder   Int     @default(0)

  template EnquiryTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
}

model Enquiry {
  id           String         @id @default(cuid())
  number       String         @unique
  customerId   String
  vesselId     String?
  ownerId      String?
  status       EnquiryStatus  @default(DRAFT)
  subject      String?
  vesselName   String?
  category     String?
  priority     String         @default("NORMAL")
  reference    String?
  deliveryPort String?
  receivedAt   DateTime       @default(now())
  dueDate      DateTime?
  notes        String?
  createdById  String?
  updatedById  String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  customer          Customer           @relation(fields: [customerId], references: [id])
  vessel            Vessel?            @relation(fields: [vesselId], references: [id])
  owner             User?              @relation("EnquiryOwner", fields: [ownerId], references: [id])
  lines             EnquiryLine[]
  rfqs              SupplierRfq[]
  customerQuotes    CustomerQuote[]
  purchaseOrders    PurchaseOrder[]
  supplierPurchases SupplierPurchase[]
  attachments       Attachment[]
  events            DocumentEvent[]
}

model EnquiryLine {
  id          String   @id @default(cuid())
  enquiryId   String
  partId      String?
  partNumber  String
  description String
  impaCode    String?
  brand       String?
  quantity    Decimal  @db.Decimal(12, 3)
  unit        String   @default("EA")
  specs       String?
  notes       String?
  sortOrder   Int      @default(0)

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  part    Part?   @relation(fields: [partId], references: [id])

  rfqLines             SupplierRfqLine[]
  supplierQuoteLines   SupplierQuoteLine[]
  customerQuoteLines   CustomerQuoteLine[]
  purchaseLines        SupplierPurchaseLine[]
}

model SupplierRfq {
  id          String    @id @default(cuid())
  number      String    @unique
  enquiryId   String
  supplierId  String
  status      String    @default("SENT")
  sentAt      DateTime  @default(now())
  openedAt    DateTime?
  respondedAt DateTime?
  dueAt       DateTime?
  notes       String?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  enquiry  Enquiry           @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  supplier Supplier          @relation(fields: [supplierId], references: [id])
  lines    SupplierRfqLine[]
  quotes   SupplierQuote[]
}

model SupplierRfqLine {
  id            String  @id @default(cuid())
  rfqId         String
  enquiryLineId String
  quantity      Decimal @db.Decimal(12, 3)
  notes         String?

  rfq         SupplierRfq @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  enquiryLine EnquiryLine @relation(fields: [enquiryLineId], references: [id], onDelete: Cascade)
}

model SupplierQuote {
  id           String    @id @default(cuid())
  number       String?
  rfqId        String
  supplierId   String
  currency     String    @default("USD")
  receivedAt   DateTime  @default(now())
  validUntil   DateTime?
  leadTimeDays Int?
  notes        String?
  createdById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  rfq      SupplierRfq         @relation(fields: [rfqId], references: [id], onDelete: Cascade)
  supplier Supplier            @relation(fields: [supplierId], references: [id])
  lines    SupplierQuoteLine[]
}

model SupplierQuoteLine {
  id              String   @id @default(cuid())
  supplierQuoteId String
  enquiryLineId   String
  partId          String?
  partNumber      String
  description     String
  quantity        Decimal  @db.Decimal(12, 3)
  unitCost        Decimal  @db.Decimal(14, 4)
  currency        String   @default("USD")
  leadTimeDays    Int?
  notes           String?

  supplierQuote SupplierQuote @relation(fields: [supplierQuoteId], references: [id], onDelete: Cascade)
  enquiryLine   EnquiryLine   @relation(fields: [enquiryLineId], references: [id], onDelete: Cascade)
  part          Part?         @relation(fields: [partId], references: [id])
}

model CustomerQuote {
  id              String    @id @default(cuid())
  number          String    @unique
  enquiryId       String
  customerId      String
  currency        String    @default("USD")
  marginPct       Decimal   @default(15) @db.Decimal(5, 2)
  status          String    @default("DRAFT")
  sentAt          DateTime?
  validUntil      DateTime?
  notes           String?
  underquoteNote  String?
  createdById     String?
  updatedById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enquiry  Enquiry             @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  customer Customer            @relation(fields: [customerId], references: [id])
  lines    CustomerQuoteLine[]
}

model CustomerQuoteLine {
  id                    String   @id @default(cuid())
  customerQuoteId       String
  enquiryLineId         String
  partId                String?
  partNumber            String
  description           String
  quantity              Decimal  @db.Decimal(12, 3)
  unitCost              Decimal  @db.Decimal(14, 4)
  unitSell              Decimal  @db.Decimal(14, 4)
  currency              String   @default("USD")
  supplierQuoteLineId   String?
  previousSellPrice     Decimal? @db.Decimal(14, 4)
  underquoteReason      String?
  sortOrder             Int      @default(0)

  customerQuote CustomerQuote @relation(fields: [customerQuoteId], references: [id], onDelete: Cascade)
  enquiryLine   EnquiryLine   @relation(fields: [enquiryLineId], references: [id], onDelete: Cascade)
  part          Part?         @relation(fields: [partId], references: [id])
}

model PurchaseOrder {
  id              String    @id @default(cuid())
  number          String    @unique
  enquiryId       String
  customerId      String
  customerPoRef   String?
  receivedAt      DateTime  @default(now())
  currency        String    @default("USD")
  notes           String?
  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  enquiry  Enquiry  @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  customer Customer @relation(fields: [customerId], references: [id])
}

model SupplierPurchase {
  id            String    @id @default(cuid())
  number        String    @unique
  enquiryId     String
  supplierId    String
  currency      String    @default("USD")
  status        String    @default("DRAFT")
  sentAt        DateTime?
  notes         String?
  trackingNo    String?
  carrier       String?
  etd           DateTime?
  eta           DateTime?
  deliveryPort  String?
  shippedAt     DateTime?
  deliveredAt   DateTime?
  createdById   String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  enquiry  Enquiry                @relation(fields: [enquiryId], references: [id], onDelete: Cascade)
  supplier Supplier               @relation(fields: [supplierId], references: [id])
  lines    SupplierPurchaseLine[]
  receipts GoodsReceipt[]
  invoices SupplierInvoice[]
  payments Payment[]
}

model SupplierPurchaseLine {
  id              String  @id @default(cuid())
  purchaseId      String
  enquiryLineId   String
  partId          String?
  partNumber      String
  description     String
  quantity        Decimal @db.Decimal(12, 3)
  unitCost        Decimal @db.Decimal(14, 4)
  currency        String  @default("USD")

  purchase    SupplierPurchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  enquiryLine EnquiryLine      @relation(fields: [enquiryLineId], references: [id], onDelete: Cascade)
  part        Part?            @relation(fields: [partId], references: [id])
}

model PriceHistory {
  id          String           @id @default(cuid())
  partId      String?
  partNumber  String
  description String?
  type        PriceHistoryType
  unitPrice   Decimal          @db.Decimal(14, 4)
  currency    String           @default("USD")
  quantity    Decimal?         @db.Decimal(12, 3)
  reference   String?
  customerId  String?
  supplierId  String?
  enquiryId   String?
  recordedAt  DateTime         @default(now())
  createdById String?
  notes       String?

  part Part? @relation(fields: [partId], references: [id])

  @@index([partNumber])
  @@index([recordedAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])
}

model Attachment {
  id           String   @id @default(cuid())
  enquiryId    String?
  fileName     String
  originalName String
  mimeType     String
  sizeBytes    Int
  label        String?
  uploadedById String?
  createdAt    DateTime @default(now())

  enquiry Enquiry? @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId])
}

enum DocumentEventType {
  CREATED
  SENT
  OPENED
  RESPONDED
  ACKNOWLEDGED
  OVERDUE
  NOTE
}

model DocumentEvent {
  id         String            @id @default(cuid())
  enquiryId  String
  entityType String
  entityId   String?
  type       DocumentEventType
  label      String
  actorId    String?
  notes      String?
  occurredAt DateTime          @default(now())

  enquiry Enquiry @relation(fields: [enquiryId], references: [id], onDelete: Cascade)

  @@index([enquiryId, occurredAt])
}

model GoodsReceipt {
  id            String   @id @default(cuid())
  number        String   @unique
  purchaseId    String
  receivedAt    DateTime @default(now())
  receivedById  String?
  deliveryPort  String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchase SupplierPurchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  lines    GoodsReceiptLine[]
  invoices SupplierInvoice[]
}

model GoodsReceiptLine {
  id              String  @id @default(cuid())
  receiptId       String
  purchaseLineId  String?
  partNumber      String
  description     String
  orderedQty      Decimal @db.Decimal(12, 3)
  receivedQty     Decimal @db.Decimal(12, 3)
  unit            String  @default("EA")
  notes           String?

  receipt GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)
}

model SupplierInvoice {
  id              String      @id @default(cuid())
  number          String      @unique
  supplierId      String
  purchaseId      String?
  receiptId       String?
  supplierInvRef  String?
  currency        String      @default("USD")
  invoiceDate     DateTime    @default(now())
  dueDate         DateTime?
  subtotal        Decimal     @default(0) @db.Decimal(14, 4)
  taxAmount       Decimal     @default(0) @db.Decimal(14, 4)
  totalAmount     Decimal     @default(0) @db.Decimal(14, 4)
  matchStatus     MatchStatus @default(UNMATCHED)
  matchNotes      String?
  status          String      @default("OPEN")
  notes           String?
  createdById     String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  supplier Supplier              @relation(fields: [supplierId], references: [id])
  purchase SupplierPurchase?     @relation(fields: [purchaseId], references: [id])
  receipt  GoodsReceipt?         @relation(fields: [receiptId], references: [id])
  lines    SupplierInvoiceLine[]
  payments Payment[]
}

model SupplierInvoiceLine {
  id          String  @id @default(cuid())
  invoiceId   String
  partNumber  String
  description String
  quantity    Decimal @db.Decimal(12, 3)
  unitCost    Decimal @db.Decimal(14, 4)
  amount      Decimal @db.Decimal(14, 4)

  invoice SupplierInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
}

model Payment {
  id            String        @id @default(cuid())
  number        String        @unique
  supplierId    String
  invoiceId     String?
  purchaseId    String?
  currency      String        @default("USD")
  amount        Decimal       @db.Decimal(14, 4)
  status        PaymentStatus @default(DRAFT)
  method        String?
  reference     String?
  scheduledAt   DateTime?
  settledAt     DateTime?
  kycCleared    Boolean       @default(false)
  notes         String?
  createdById   String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  supplier Supplier         @relation(fields: [supplierId], references: [id])
  invoice  SupplierInvoice? @relation(fields: [invoiceId], references: [id])
  purchase SupplierPurchase? @relation(fields: [purchaseId], references: [id])
}

model Contract {
  id            String         @id @default(cuid())
  number        String         @unique
  title         String
  supplierId    String?
  portId        String?
  portName      String?
  category      String?
  status        ContractStatus @default(DRAFT)
  isTender      Boolean        @default(false)
  currency      String         @default("USD")
  valueAmount   Decimal?       @db.Decimal(14, 4)
  startDate     DateTime?
  endDate       DateTime?
  terms         String?
  notes         String?
  createdById   String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  supplier Supplier? @relation(fields: [supplierId], references: [id])
  port     Port?     @relation(fields: [portId], references: [id])
}
